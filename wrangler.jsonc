{
  "name": "agentfabric",
  "main": "dist/deploy/cloudflare.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "AGENTFABRIC_MODE": "remote"
  }
}
