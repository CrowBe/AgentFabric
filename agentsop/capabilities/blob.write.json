{
  "agentsop": "0.1",
  "id": "blob.write",
  "title": "Create blob",
  "description": "Create a new text resource in the workspace. The fabric chooses the locator from a human label. Labels are hints, not paths, and never replace an existing resource. Returns a new ResourceRef.",
  "input": {
    "type": "object",
    "properties": {
      "label": { "type": "string" },
      "text": { "type": "string" },
      "kind": { "type": "string", "enum": ["blob", "journal"] }
    },
    "required": ["label", "text"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "resource": { "$ref": "#/$defs/ResourceRef" }
    },
    "required": ["resource"],
    "additionalProperties": false
  },
  "effects": ["create"],
  "idempotent": false,
  "authority": {
    "resources": [],
    "effects": ["create"]
  },
  "depends_on": []
}
