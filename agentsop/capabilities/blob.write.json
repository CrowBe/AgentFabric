{
  "agentsop": "0.1",
  "id": "blob.write",
  "title": "Write blob",
  "description": "Create or replace a text resource in the workspace. The fabric chooses the locator from a human label. Returns a ResourceRef. Labels are not paths the caller is entitled to choose.",
  "input": {
    "type": "object",
    "properties": {
      "label": { "type": "string" },
      "text": { "type": "string" },
      "kind": { "type": "string", "enum": ["blob", "journal"] }
    },
    "required": ["label", "text"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "resource": { "$ref": "#/$defs/ResourceRef" }
    },
    "required": ["resource"],
    "additionalProperties": false
  },
  "effects": ["create", "write"],
  "idempotent": false,
  "authority": {
    "resources": [],
    "effects": ["create", "write"]
  },
  "depends_on": []
}
